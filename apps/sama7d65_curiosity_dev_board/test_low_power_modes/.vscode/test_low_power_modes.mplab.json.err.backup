{
    "version": "1.8",
    "configurations": [
        {
            "name": "default",
            "id": "",
            "device": "SAMA7D65",
            "imagePath": "./out/test_low_power_modes/default.elf",
            "toolProperties": "default-tool-base",
            "tool": "PICkit 5",
            "packs": [
                {
                    "name": "SAMA7D65_DFP",
                    "vendor": "Microchip",
                    "version": "1.11.113"
                },
                {
                    "name": "CMSIS",
                    "vendor": "ARM",
                    "version": "6.3.0"
                }
            ],
            "fileSet": "default",
            "toolchain": "default-XC32",
            "userVariables": "default-uservariables"
        }
    ],
    "propertyGroups": [
        {
            "name": "default-uservariables",
            "type": "uservariables",
            "properties": {
                "boot.use": "true",
                �"boot.path": "./binaries/at91bootstrap.elf "
            }
        },
        {
            "name": "default-XC32",
            "type": "toolchain",
            "provider": "microchip.toolchains:xc32@4.60",
            "properties": {
                "compiler.isolate-each-function": true,
                "compiler.place-data-into-section": true,
                "linker.heap-size": "512",
                "linker.remove-unused-sections": true,
                "compiler++.isolate-each-function": true,
                "compiler.extra-include-directories": [
                    "My_MCC_Config/src",
                    "My_MCC_Config/src/config/default",
                    "My_MCC_Config/src/packs/CMSIS",
                    "My_MCC_Config/src/packs/CMSIS/CMSIS/Core_A/Include",
                    "My_MCC_Config/src/packs/SAMA7D65_DFP"
                ],
                "linker.no-device-startup-code": "true",
                "compiler.additional-options": [
                    "-marm"
                ],
                "compiler++.extra-include-directories": [
                    "My_MCC_Config/src",
                    "My_MCC_Config/src/config/default",
                    "My_MCC_Config/src/packs/CMSIS",
                    "My_MCC_Config/src/packs/CMSIS/CMSIS/Core_A/Include",
                    "My_MCC_Config/src/packs/SAMA7D65_DFP"
                ],
                "compiler++.optimization-level": "-Os"
            }
        },
        {
            "name": "default-tool-base",
            "type": "tool",
            "properties": {}
        }
    ],
